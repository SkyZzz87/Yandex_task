-- Задача 1.1
-- promo_campaigns (campaign_id, campaign_name, channel, start_date, end_date)
-- promo_events (event_id, campaign_id, user_id, event_type, event_dt)
-- event_type: 'view', 'click', 'action'
-- users (user_id, department, city)
-- Напишите SQL-запрос, который отдавал бы по каждой промокампании число уникальных
-- сотрудников по просмотрам, число уникальных кликов, конверсию из просмотров в клики в
-- процентах. Результат отсортируйте по конверсии

SELECT
    pc.campaign_id,
    pc.campaign_name,
    COUNT(DISTINCT CASE
        WHEN pe.event_type = 'view' THEN pe.user_id
    END) AS unique_viewers,
    COUNT(DISTINCT CASE
        WHEN pe.event_type = 'click' THEN pe.user_id
    END) AS unique_clickers,
    ROUND(
        100.0 * COUNT(DISTINCT CASE
            WHEN pe.event_type = 'click' THEN pe.user_id
        END)
        / NULLIF(
            COUNT(DISTINCT CASE
                WHEN pe.event_type = 'view' THEN pe.user_id
            END),
            0
        ),
        2
    ) AS conversion_percent
FROM promo_campaigns pc
LEFT JOIN promo_events pe
    ON pc.campaign_id = pe.campaign_id
GROUP BY
    pc.campaign_id,
    pc.campaign_name
ORDER BY
    conversion_percent DESC;


-- Задача 1.2
-- Доработайте запрос так, чтобы остались только те промокампании, в которых клики были
-- от сотрудников из >5 разных департаментов компании

SELECT
    pc.campaign_id,
    pc.campaign_name,
    COUNT(DISTINCT CASE
        WHEN pe.event_type = 'view' THEN pe.user_id
    END) AS unique_viewers,
    COUNT(DISTINCT CASE
        WHEN pe.event_type = 'click' THEN pe.user_id
    END) AS unique_clickers,
    ROUND(
        100.0 * COUNT(DISTINCT CASE
            WHEN pe.event_type = 'click' THEN pe.user_id
        END)
        / NULLIF(
            COUNT(DISTINCT CASE
                WHEN pe.event_type = 'view' THEN pe.user_id
            END),
            0
        ),
        2
    ) AS conversion_percent
FROM promo_campaigns pc
LEFT JOIN promo_events pe
    ON pc.campaign_id = pe.campaign_id
LEFT JOIN users u
    ON pe.user_id = u.user_id
GROUP BY
    pc.campaign_id,
    pc.campaign_name
HAVING COUNT(DISTINCT CASE
    WHEN pe.event_type = 'click' THEN u.department
END) > 5
ORDER BY
    conversion_percent DESC;


